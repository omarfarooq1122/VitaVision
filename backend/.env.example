# --- Supabase (persistence + auth verification) ---------------------------
# Copy these from your Lovable Cloud project's frontend .env (URL + publishable
# key are safe to reuse). The service role key is optional and only needed for
# maintenance jobs; never expose it to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- YOLOv11 detection ----------------------------------------------------
YOLO_MODEL_PATH=models/food_yolov11.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_DEVICE=auto          # auto | cpu | cuda
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=40

# --- Image handling -------------------------------------------------------
MAX_IMAGE_SIZE_MB=8
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=4096
ENHANCE_BRIGHTNESS=true
DENOISE=false

# --- API ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_ANALYZE=20/minute
REQUIRE_AUTH=true
NUTRITION_FALLBACK_FILE=../data/nutrition/foods.json
